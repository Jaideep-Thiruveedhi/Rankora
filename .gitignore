# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env.example is currently EXCLUDED until a sanitized,
# placeholder-only template is reviewed (it still contains real-looking values).
# Re-add an explicit negation only after the values have been scrubbed.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/migrations/

# scripts output
*.log
dist/

# Apply AI private document storage (never commit uploaded documents)
/storage/

# one-off local repair debris + generated agent session logs (machine-local only)
/fix-*.js
.agents/