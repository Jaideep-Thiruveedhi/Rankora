{
  "manifest_version": 3,
  "name": "Rankora Apply Agent",
  "version": "1.0.0",
  "description": "AI-assisted autofill for examination application forms. You review and approve every fill. The agent never submits, pays, or bypasses CAPTCHA/OTP.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Rankora Apply Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "102"
}
